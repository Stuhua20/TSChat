DB_DIALECT=sqlite
DB_URI=sqlite:///data/business.db
APP_DB_URI=sqlite:///data/app.db

MCP_HOST=127.0.0.1
MCP_SERVER_URL=http://127.0.0.1:3001/mcp

# LLM：OpenAI 及任何兼容 ChatGPT 协议的接口。OPENAI_BASE_URL 留空即用 OpenAI 官方接口。
# 兼容接口示例：
#   DeepSeek:      OPENAI_BASE_URL=https://api.deepseek.com/v1   OPENAI_MODEL=deepseek-chat
#   Moonshot Kimi: OPENAI_BASE_URL=https://api.moonshot.cn/v1    OPENAI_MODEL=kimi-k2-0905-preview
#   本地 vLLM:     OPENAI_BASE_URL=http://127.0.0.1:8000/v1
#   本地 Ollama:   OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Set true when serving over HTTPS.
APP_SECURE_COOKIE=false
